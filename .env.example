# Node 版（server.mjs）配置；Cloudflare Worker 的密码在 Worker 的 Secrets 中设置
PORT=8080

# 访问密码与管理员密码（设置面板），留空表示不需要
PASSWORD=
ADMINPASSWORD=

# 登录 Cookie 的签名密钥（可选）。不设置时由 PASSWORD/ADMINPASSWORD 派生，修改密码会让所有设备重新登录
SESSION_SECRET=

# 限流（每个客户端 IP 每分钟的次数）
LOGIN_RATE_LIMIT=10
PROXY_RATE_LIMIT=300

# 部署在反向代理（如 Nginx）之后时设为 true：按 X-Forwarded-For 识别客户端 IP 并识别 HTTPS
TRUST_PROXY=false
