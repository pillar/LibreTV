{
  "appId": "app.playany.tv",
  "appName": "PlayAny TV",
  "webDir": "www",
  "backgroundColor": "#07070c",
  "server": {
    "cleartext": true
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
